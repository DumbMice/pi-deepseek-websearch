{
  "name": "pi-deepseek-websearch",
  "version": "0.1.0",
  "description": "Web search and page fetch for pi via DeepSeek's Search & Fetch APIs: publication dates, authority, rerank score, ori_question, count up to 50, and graceful 128-char handling. Coexists with pi-web-access.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "yangbangcheng",
    "email": "bangchengyang@hotmail.com"
  },
  "homepage": "https://github.com/DumbMice/pi-deepseek-websearch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DumbMice/pi-deepseek-websearch.git"
  },
  "bugs": "https://github.com/DumbMice/pi-deepseek-websearch/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "deepseek",
    "web-search",
    "web-fetch",
    "search-api",
    "llm-tools",
    "websearch",
    "deepseek-search"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/index.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
